{
  "name": "field-cad-browser",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "install:ci": "pnpm install --no-frozen-lockfile",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/package-assets.mjs",
    "test": "node --test tests/*.test.mjs",
    "ios:sync": "node scripts/prepare-ios.mjs",
    "ios:open": "cap open ios",
    "ios:check": "node scripts/check-ios.mjs",
    "ios:package": "node scripts/package-ios.mjs"
  },
  "dependencies": {
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.2",
    "@capacitor/share": "8.0.3",
    "@mlightcad/libredwg-web": "0.9.3",
    "@pdf-lib/fontkit": "1.1.1",
    "dialog-polyfill": "0.5.6",
    "dxf-parser": "1.1.2",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "vite": "6.4.1"
  }
}
